# ─── TinaCloud (solo necesario para producción con TinaCloud) ───────────────
# Obtén estos valores en https://app.tina.io → tu proyecto → Overview
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Rama de Git que usa TinaCloud como fuente de contenido
GITHUB_BRANCH=main

# ─── Agenda (Google Calendar · /mapa-de-fugas y /agenda-admin) ─────────────
# Server-only secrets: set them in Railway → Variables. Never prefix them with NEXT_PUBLIC_.
# Without them the booking API answers 503 {error:'not_configured'} and step 4 shows a WhatsApp fallback.

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application), consent screen "Internal".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered EXACTLY as an authorized redirect URI in that OAuth client.
GOOGLE_REDIRECT_URI=https://go.manya.pe/api/agenda/oauth/callback

# Supabase → Project Settings → API. The service role key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts Google refresh tokens at rest. Changing it disconnects every calendar.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENDA_ENCRYPTION_KEY=

# Password for /agenda-admin, and the secret that signs the admin session cookie and OAuth state.
# Generate the secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENDA_ADMIN_PASSWORD=
AGENDA_SESSION_SECRET=

# Make custom webhook that receives mapa_de_fugas_lead and mapa_de_fugas_booking events (optional;
# if empty, bookings still work and the event is only logged as skipped).
MAKE_AGENDA_WEBHOOK_URL=

# Optional: public base URL (defaults to https://go.manya.pe).
NEXT_PUBLIC_SITE_URL=

# ─── Notas ──────────────────────────────────────────────────────────────────
# En modo local (desarrollo) NO se necesitan estas variables.
# TinaCMS lee y escribe directamente en los archivos content/**/*.json del repo.
# Copia este archivo como .env.local y rellena los valores para activar TinaCloud.
